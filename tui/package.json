{
  "name": "@kral/vto-tui",
  "version": "0.1.0",
  "description": "vto ui - live terminal UI for vto/Vitest runs (Ink)",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run test/e2e.test.ts",
    "start": "node bin/vto-ui.mjs",
    "mock": "npm run build && node bin/vto-ui.mjs --mock",
    "mock:big": "npm run build && node bin/vto-ui.mjs --mock --mock-tests 10000 --mock-failures 500 --mock-duration 15000",
    "mock:ci": "npm run build && node bin/vto-ui.mjs --mock --ci --mock-speed 4",
    "mock:daemon": "npm run build && node bin/vto-ui.mjs mock-daemon",
    "bench": "node --expose-gc --import tsx bench/bench.tsx",
    "dev": "tsx src/cli.tsx"
  },
  "dependencies": {
    "chalk": "6.0.1",
    "cli-boxes": "4.0.1",
    "cross-spawn": "7.0.6",
    "ink": "8.0.0",
    "react": "19.3.1",
    "string-width": "8.3.0",
    "strip-ansi": "7.2.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "private": true,
  "type": "module",
  "bin": {
    "vto-ui": "./bin/vto-ui.mjs"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "files": [
    "bin/",
    "dist/",
    "dev/fixture/",
    "README.md",
    "README.cs.md"
  ],
  "license": "MIT OR Apache-2.0"
}
