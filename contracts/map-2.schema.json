{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vto.invalid/contracts/map-2.schema.json",
  "title": "vto stored map (format 2) – one line of the file written by `vto pack`",
  "description": "The ONE portable stored form of a coverage map: a single JSONL file. Same record kinds as raw-2 with these extra rules. Per record (this schema): every path is root-relative (no absolute paths, no '..' prefix is produced); `test.hits` is required; `test.line` is an integer or null. Per file (checked by analyzer/tests/contracts.rs, not expressible per line): (1) the FIRST record is a meta record with `stored: true`, `pathBase: \"root\"`, `version: 2`; (2) every `file` record precedes the records that reference it; (3) every hit id is a valid index into that file's `blocks`; (4) at most one `test` record per (file, name, line); (5) at most one `fileload` per testFile; import-time `hits` are stored once (on the first fileload). Readers resolve paths against THEIR canonical root (DECISIONS D2.6).",
  "oneOf": [
    {
      "$ref": "#/$defs/meta"
    },
    {
      "$ref": "#/$defs/file"
    },
    {
      "$ref": "#/$defs/fileload"
    },
    {
      "$ref": "#/$defs/test"
    }
  ],
  "$defs": {
    "path": {
      "$ref": "#/$defs/relPath"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "minLength": 40,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "hitMap": {
      "type": "object",
      "description": "file path → sorted block ids (indices into that file's `blocks`)",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "block": {
      "type": "array",
      "description": "[startLine (1-based), startCol (0-based), endLine, endCol, kind]; the array index is the block id. Stored maps write 0 for both columns and kind \"b\".",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "enum": [
            "s",
            "b",
            "f"
          ]
        }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "dirtyEntry": {
      "anyOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "type": "object",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "$ref": "#/$defs/path"
            },
            "sha256": {
              "anyOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ],
              "description": "contentHash (DECISIONS D1) of the file at record time; null = the file was deleted"
            }
          }
        }
      ]
    },
    "module": {
      "anyOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "type": "object",
          "required": [
            "file"
          ],
          "additionalProperties": false,
          "properties": {
            "file": {
              "$ref": "#/$defs/path"
            },
            "loadMs": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      ]
    },
    "read": {
      "anyOf": [
        {
          "type": "string",
          "description": "path of a file or directory; \"\" or \".\" = the root itself"
        },
        {
          "type": "object",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            }
          }
        }
      ]
    },
    "meta": {
      "type": "object",
      "required": [
        "t",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "meta"
        },
        "version": {
          "const": 2
        },
        "gitHead": {
          "anyOf": [
            {
              "$ref": "#/$defs/commit"
            },
            {
              "type": "null"
            }
          ],
          "description": "Commit the map was recorded at."
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "The working tree had uncommitted changes at record time (null: not a git repository)."
        },
        "dirtyFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dirtyEntry"
          },
          "x-since": "2.2",
          "description": "Files modified / untracked at record time (git status --porcelain=v1 -z --untracked-files=all). Required for `vto affected` to use a dirty map (DECISIONS D5.9)."
        },
        "testFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "x-since": "2.2",
          "description": "Every test file Vitest collected, including files without any test record."
        },
        "setupFiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "stored": {
          "type": "boolean"
        },
        "pathBase": {
          "const": "root"
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "t",
        "file",
        "blocks"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "file"
        },
        "file": {
          "$ref": "#/$defs/path"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256",
          "description": "contentHash of the ORIGINAL file (DECISIONS D1)."
        }
      }
    },
    "fileload": {
      "type": "object",
      "required": [
        "t",
        "testFile",
        "modules"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "fileload"
        },
        "testFile": {
          "$ref": "#/$defs/path"
        },
        "hits": {
          "$ref": "#/$defs/hitMap"
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module"
          },
          "description": "Every module evaluated for the test file, up to its last hook (not only until the first beforeAll)."
        },
        "loadMs": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "reads": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/read"
          },
          "x-since": "2.1"
        },
        "readsComplete": {
          "type": "boolean",
          "x-since": "2.2",
          "description": "true: every fs entry point was wrapped and no child process / worker was started; false: something escaped (DECISIONS D5.8)."
        },
        "error": {
          "type": "boolean",
          "x-since": "2.2",
          "description": "The test file failed to load or a file-level hook threw: coverage incomplete."
        }
      }
    },
    "test": {
      "type": "object",
      "required": [
        "t",
        "file",
        "name",
        "state",
        "hits"
      ],
      "additionalProperties": false,
      "properties": {
        "t": {
          "const": "test"
        },
        "file": {
          "$ref": "#/$defs/path"
        },
        "name": {
          "type": "string",
          "description": "Full name, describe chain joined by \" > \"."
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "state": {
          "enum": [
            "pass",
            "fail",
            "skip",
            "todo"
          ]
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "assertions": {
          "type": "integer",
          "minimum": 0
        },
        "hits": {
          "$ref": "#/$defs/hitMap"
        },
        "tainted": {
          "type": "boolean"
        },
        "leaky": {
          "type": "boolean"
        },
        "retryCount": {
          "type": "integer",
          "minimum": 0
        },
        "assertHash": {
          "type": "string"
        },
        "domHash": {
          "type": "string"
        }
      }
    },
    "relPath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^([A-Za-z]:|/|\\\\|\\.\\./)"
      },
      "description": "root-relative, '/' separators (never absolute, never leaving the root)"
    }
  }
}
