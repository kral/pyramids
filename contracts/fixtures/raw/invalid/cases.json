  {
   "t": "meta",
   "version": 2,
   "gitHead": null
  },
  {
   "t": "file",
   "file": "src/a.ts",
   "blocks": [
    [
     1,
     0,
     3,
     1,
     "f"
    ]
   ]
  }
 ],
 "cases": [
  {
   "name": "unknown record kind",
   "record": {
    "t": "tset",
    "file": "test/a.test.ts",
    "name": "a",
    "state": "pass"
   },
   "why": "reader ignores unknown kinds; a producer must not emit them",
   "reader": "schema"
  },
  {
   "name": "misspelled field (reads → read)",
   "record": {
    "t": "fileload",
    "testFile": "test/a.test.ts",
    "modules": [],
    "read": [
     "docs"
    ]
   },
   "why": "REVIEW-2-architecture §2.2/4: silently loses fs protection",
   "reader": "schema"
  },
  {
