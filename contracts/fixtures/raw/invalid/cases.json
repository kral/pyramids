   "record": {
    "t": "test",
    "file": "test/a.test.ts",
    "name": "a",
    "line": 1,
    "hits": {}
   },
   "why": "state is required",
   "reader": "schema"
  },
  {
   "name": "test with unknown state",
   "record": {
    "t": "test",
    "file": "test/a.test.ts",
    "name": "a",
    "line": 1,
    "state": "passed",
    "hits": {}
