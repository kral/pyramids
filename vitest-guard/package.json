{
  "name": "@jirikral/vitest-guard",
  "version": "0.2.0-alpha.0",
  "vitestGuardProtocol": 1,
  "description": "Makes Vitest fast pools (vmThreads, isolate:false) safe: realm shims, leak detection, quarantine, false-green verification",
  "keywords": [
    "isolate",
    "jsdom",
    "react",
    "test performance",
    "vitest",
    "vmThreads"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kral/vto.git",
    "directory": "vitest-guard"
  },
  "homepage": "https://github.com/kral/vto/tree/main/docs/vitest-guard",
  "bugs": {
    "url": "https://github.com/kral/vto/issues"
  },
  "type": "module",
  "bin": {
    "vitest-guard": "./bin/vitest-guard.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./setup": "./src/setup.bundle.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE-APACHE",
    "LICENSE-MIT",
    "README.cs.md",
    "README.md",
    "bin/",
    "src/"
  ],
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "peerDependencies": {
    "vitest": ">=4.1 <6"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "build": "node scripts/bundle-setup.mjs",
    "check:bundle": "node scripts/bundle-setup.mjs --check",
    "test": "node scripts/bundle-setup.mjs && node --test --test-concurrency=1 test/*.test.mjs",
    "test:unit": "VITEST_GUARD_TEST_NO_INTEGRATION=1 node --test test/*.test.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "next"
  }
}
